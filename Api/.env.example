NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/hariculture
JWT_SECRET=change-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
DEFAULT_GREENHOUSE_CODE=0000
CAMERA_COMMAND=rpicam-vid
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FRAMERATE=15
CAMERA_QUALITY=85
CAMERA_START_TIMEOUT_MS=10000
CAMERA_IDLE_STOP_MS=2000
HARDWARE_MODE=raspberry
HARDWARE_TIMEOUT_MS=8000
GPIO_CHIP=0
DHT11_PIN=24
BH1750_I2C_BUS=1
BH1750_ADDRESS=0x23
SOIL_SENSOR_PIN=25
SOIL_WET_LEVEL=0
PUMP_PIN=18
PUMP_ACTIVE_LOW=false
LIGHT_PIN=23
LIGHT_ACTIVE_LOW=false
VENTILATION_PIN=17
VENTILATION_ACTIVE_LOW=false
AUTH_RATE_LIMIT=10
PAIRING_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=900000
GREENHOUSE_OFFLINE_AFTER_MS=120000
